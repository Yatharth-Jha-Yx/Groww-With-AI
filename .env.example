# Copy this file to `.env` and fill in ONE of the three login options.
# `.env` is git-ignored, so your keys never get pushed to GitHub.
# Never paste these values into a chat window.

# --- Option A: paste a ready access token (simplest, expires daily at 6 AM) ---
GROWW_ACCESS_TOKEN=

# --- Option B: API key + TOTP secret (fully automatic, recommended) ---
# On groww.in/trade-api/api-keys -> Generate API key -> choose the TOTP type.
GROWW_API_KEY=
GROWW_TOTP_SECRET=

# --- Option C: API key + API secret (you approve once a day on the dashboard) ---
GROWW_API_SECRET=

# --- Safety switches for placing orders ---
# Orders are DRY-RUN (simulated) unless this is exactly "true".
GROWW_ALLOW_LIVE_ORDERS=false
# Hard cap: any single order worth more than this (in Rs.) is refused.
GROWW_MAX_ORDER_VALUE=10000
